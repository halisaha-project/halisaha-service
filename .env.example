NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/halisaha
# Production JWT secrets must be different and at least 32 characters each.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated exact browser origins. Production requires at least one and
# does not permit *. Example: http://localhost:3001,http://localhost:8081
CORS_ORIGINS=http://localhost:3001

# Enable only behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Optional in development/test. Production requires both values.
# Keep the API key secret and use a sender on a Resend-verified domain.
# RESEND_API_KEY=replace-with-resend-api-key
# MAIL_FROM=App Name <mail@verified-domain.example>

# Centralized display name used in transactional email content.
APP_NAME=Halisaha
